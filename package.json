{
  "name": "@lnsy/markdown-editor",
  "version": "0.2.0",
  "description": "A lightweight Markdown editor Web Component built on CodeMirror 6",
  "type": "module",
  "main": "dist/markdown-editor.min.js",
  "module": "dist/markdown-editor.min.js",
  "exports": {
    ".": {
      "import": "./dist/markdown-editor.min.js",
      "default": "./dist/markdown-editor.min.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DATAROOM-NETWORK/markdown-editor.git"
  },
  "keywords": [
    "markdown",
    "editor",
    "web-component",
    "codemirror",
    "lnsy"
  ],
  "author": "LNSY",
  "license": "Unlicense",
  "bugs": {
    "url": "https://github.com/DATAROOM-NETWORK/markdown-editor/issues"
  },
  "homepage": "https://github.com/DATAROOM-NETWORK/markdown-editor#readme",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "NODE_ENV=development rspack serve",
    "build": "NODE_ENV=production rspack build",
    "verify:pack": "npm pack --dry-run",
    "prepublishOnly": "npm run build && npm run verify:pack"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.19.0",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-markdown": "^6.4.0",
    "@codemirror/language": "^6.11.3",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "codemirror": "^6.0.2",
    "dataroom-js": "^0.6.0",
    "htmlhint": "^1.6.3"
  },
  "devDependencies": {
    "@rspack/cli": "^1.5.6",
    "@rspack/core": "^1.5.6",
    "@rspack/dev-server": "^1.1.4",
    "css-loader": "^7.1.2",
    "dotenv": "^17.2.2",
    "style-loader": "^4.0.0"
  },
  "files": [
    "dist/",
    "styles/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
